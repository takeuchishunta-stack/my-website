# --- 必須 ---
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- 任意 ---
# 使用モデル（既定: claude-opus-5）
# コストを抑えたい場合は claude-sonnet-5 に変更可
NOTEKIT_MODEL=claude-opus-5

# 思考の深さ: low | medium | high | xhigh | max（既定: high）
NOTEKIT_EFFORT=high

# note APIへのリクエスト間隔(ms)。既定1500。短くしすぎない
NOTEKIT_RATE_LIMIT_MS=1500
